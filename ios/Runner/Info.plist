<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN"
  "http://www.apple.com/DTDs/PropertyList-1.0.dtd">

<plist version="1.0">
<dict>

    <!-- =====================================================
         APP CONFIGURATION
         ===================================================== -->

    <key>CADisableMinimumFrameDurationOnPhone</key>
    <true/>

    <key>CFBundleDevelopmentRegion</key>
    <string>$(DEVELOPMENT_LANGUAGE)</string>

    <key>CFBundleDisplayName</key>
    <string>Technicianapp</string>

    <key>CFBundleExecutable</key>
    <string>$(EXECUTABLE_NAME)</string>

    <key>CFBundleIdentifier</key>
    <string>$(PRODUCT_BUNDLE_IDENTIFIER)</string>

    <key>CFBundleInfoDictionaryVersion</key>
    <string>6.0</string>

    <key>CFBundleName</key>
    <string>technicianapp</string>

    <key>CFBundlePackageType</key>
    <string>APPL</string>

    <key>CFBundleShortVersionString</key>
    <string>$(FLUTTER_BUILD_NAME)</string>

    <key>CFBundleSignature</key>
    <string>????</string>

    <key>CFBundleVersion</key>
    <string>$(FLUTTER_BUILD_NUMBER)</string>

    <key>LSRequiresIPhoneOS</key>
    <true/>


    <!-- =====================================================
         CAMERA PERMISSION
         ===================================================== -->

    <key>NSCameraUsageDescription</key>
    <string>Technicianapp needs access to your camera to take photos for service requests and documentation.</string>


    <!-- =====================================================
         PHOTO LIBRARY / GALLERY PERMISSION
         ===================================================== -->

    <key>NSPhotoLibraryUsageDescription</key>
    <string>Technicianapp needs access to your photos so you can select and upload images for service requests.</string>

    <!-- If the app saves photos to the user's gallery -->
    <key>NSPhotoLibraryAddUsageDescription</key>
    <string>Technicianapp needs permission to save photos to your photo library.</string>


    <!-- =====================================================
         LOCATION PERMISSIONS
         ===================================================== -->

    <!-- Location while app is being used -->
    <key>NSLocationWhenInUseUsageDescription</key>
    <string>Technicianapp uses your location to provide accurate service location information and help technicians with service requests.</string>

    <!-- Location when app may also operate in the background -->
    <key>NSLocationAlwaysAndWhenInUseUsageDescription</key>
    <string>Technicianapp uses your location to provide service location information and technician updates.</string>

    <key>NSLocationAlwaysUsageDescription</key>
    <string>We need your location in background to track job progress.</string>


    <!-- =====================================================
         NOTIFICATIONS

         No notification usage-description key is required
         in Info.plist.

         Notification permission is requested at runtime.
         ===================================================== -->

    <!-- =====================================================
         BACKGROUND MODES
         Required for Firebase Cloud Messaging (FCM) to
         deliver silent push notifications and wake the app
         when a remote notification arrives.
         ===================================================== -->

    <key>UIBackgroundModes</key>
    <array>
        <!-- Allows FCM to deliver data-only (silent) pushes -->
        <string>remote-notification</string>
        <!-- Lets the OS call your background fetch handler -->
        <string>fetch</string>
        <!-- Required for background GPS location updates -->
        <string>location</string>
    </array>


    <!-- =====================================================
         APP SCENE CONFIGURATION
         ===================================================== -->

    <key>UIApplicationSceneManifest</key>
    <dict>

        <key>UIApplicationSupportsMultipleScenes</key>
        <false/>

        <key>UISceneConfigurations</key>
        <dict>

            <key>UIWindowSceneSessionRoleApplication</key>
            <array>

                <dict>

                    <key>UISceneClassName</key>
                    <string>UIWindowScene</string>

                    <key>UISceneConfigurationName</key>
                    <string>flutter</string>

                    <key>UISceneDelegateClassName</key>
                    <string>$(PRODUCT_MODULE_NAME).SceneDelegate</string>

                    <key>UISceneStoryboardFile</key>
                    <string>Main</string>

                </dict>

            </array>

        </dict>

    </dict>


    <!-- =====================================================
         INPUT EVENTS
         ===================================================== -->

    <key>UIApplicationSupportsIndirectInputEvents</key>
    <true/>


    <!-- =====================================================
         LAUNCH SCREEN
         ===================================================== -->

    <key>UILaunchStoryboardName</key>
    <string>LaunchScreen</string>

    <key>UIMainStoryboardFile</key>
    <string>Main</string>


    <!-- =====================================================
         SUPPORTED ORIENTATION
         ===================================================== -->

    <key>UISupportedInterfaceOrientations</key>
    <array>
        <string>UIInterfaceOrientationPortrait</string>
    </array>

    <!-- =====================================================
         URL SCHEMES FOR EXTERNAL APPS (url_launcher)
         ===================================================== -->
    <key>LSApplicationQueriesSchemes</key>
    <array>
        <string>comgooglemaps</string>
        <string>https</string>
    </array>

</dict>
</plist>